+// ZenX
+NS_IMETHODIMP
+nsMacDockSupport::ZenxSetWindowOpacity(mozIDOMWindowProxy* aWindow,
+                                       float aOpacity) {
+  NS_ENSURE_ARG(aWindow);
+  nsCOMPtr<nsPIDOMWindowOuter> window = nsPIDOMWindowOuter::From(aWindow);
+  nsCOMPtr<nsIWidget> widget =
+      mozilla::widget::WidgetUtils::DOMWindowToWidget(window);
+  NS_ENSURE_TRUE(widget, NS_ERROR_FAILURE);
+  widget->SetWindowOpacity(std::clamp(aOpacity, 0.0f, 1.0f));
+  return NS_OK;
+}
