# ZenX additions on top of Zen. Kept out of src/zen so upstream merges
# rarely touch them.

EXTRA_JS_MODULES.zenx += [
    "ZenXCommandLine.sys.mjs",
    "ZenXProfileSpaces.sys.mjs",
    "ZenXProfileSpacesUI.mjs",
]

EXTRA_JS_MODULES.zenx.arc += [
    "arc/ZenXArcImporter.sys.mjs",
    "arc/ZenXArcProfileMigrator.sys.mjs",
    "arc/ZenXArcSidebar.sys.mjs",
]

JAR_MANIFESTS += ["jar.mn"]

XPCOM_MANIFESTS += ["components.conf"]

BROWSER_CHROME_MANIFESTS += ["tests/browser.toml"]
XPCSHELL_TESTS_MANIFESTS += ["tests/unit/xpcshell.toml"]
